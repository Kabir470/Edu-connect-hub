{
  "expo": {
    "name": "EdeX",
    "slug": "academic-connect",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/thumbnails/Thumbnail.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/thumbnails/Thumbnail.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.academicconnect.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.academicconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/026f34d3-debd-43cb-9a4e-51b2b73cf4ca"
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#6C63FF"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#6C63FF"
        }
      ]
    ],
    "extra": {
      "payment": {
        "apiBaseUrl": "",
        "currency": "BDT",
        "demoMode": true,
        "sandboxGatewayUrl": "https://sandbox.sslcommerz.com/EasyCheckOut/testbox/",
        "mockDelayMs": 2000
      },
      "eas": {
        "projectId": "026f34d3-debd-43cb-9a4e-51b2b73cf4ca"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
